{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Delivery": {
    "Warehouse": {
      "Name": "newstore warehouse, Tempelhof, Berlin",
      "Latitude": 52.4836,
      "Longitude": 13.3897
    },
    "Courier": {
      "PrepareTime": "00:00:30",
      "TravelTime": "00:04:30",
