{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "Downloads": { "LinkLifetime": "00:15:00" },
    "Processing": {
      "PollInterval": "00:00:02",
      "Lease": "00:02:00",
      "MaxAttempts": 3,
      "RetryPause": "00:00:30",
      "MaxRetryPause": "00:10:00",
      "JobTimeout": "01:00:00",
      "X264Preset": "medium"
    }
  },
  "Auth": {
    "Issuer": "http://localhost:8180/realms/newstore",
    "Audience": "media",
    "UserClients": [ "gateway" ]
  }
}
